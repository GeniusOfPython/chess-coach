{
  "name": "chess-coach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src server api e2e scripts vite.config.ts playwright.config.ts",
    "test": "vitest run --exclude e2e/**",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "eval:ai-coach": "vitest run src/ai/evaluation/aiCoachEval.test.ts --reporter=verbose",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "node scripts/run-quality-gate.mjs",
    "check:ci": "node scripts/run-quality-gate.mjs --with-e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.2.7",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.2.7",
    "stockfish": "^18.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
