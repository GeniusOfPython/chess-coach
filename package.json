{
  "name": "chess-coach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src server api e2e scripts vite.config.ts playwright.config.ts",
    "test": "vitest run --exclude \"e2e/**\"",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/learning-cycle.spec.ts --project=chromium",
    "test:e2e:a11y": "playwright test e2e/accessibility.spec.ts --project=chromium",
    "test:e2e:offline": "playwright test e2e/offline.spec.ts --project=chromium",
    "test:e2e:keyboard": "playwright test e2e/keyboard-navigation.spec.ts --project=chromium",
    "test:e2e:performance": "playwright test e2e/performance.spec.ts --project=chromium",
    "test:e2e:recovery": "playwright test e2e/storage-recovery.spec.ts --project=chromium",
    "test:e2e:migration": "playwright test e2e/storage-migration.spec.ts --project=chromium",
    "test:e2e:repetition": "playwright test e2e/spaced-repetition.spec.ts --project=chromium",
    "test:e2e:onboarding": "playwright test e2e/onboarding.spec.ts --project=chromium",
    "test:e2e:entitlement": "playwright test e2e/entitlement.spec.ts --project=chromium",
    "test:e2e:webkit": "playwright test e2e/learning-cycle.spec.ts e2e/keyboard-navigation.spec.ts --project=webkit",
    "test:e2e:visual": "playwright test e2e/visual.spec.ts",
    "test:e2e:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "test:e2e:install": "playwright install chromium webkit",
    "eval:ai-coach": "vitest run src/ai/evaluation/aiCoachEval.test.ts --reporter=verbose",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:e2e-contracts": "node scripts/check-e2e-contracts.mjs",
    "check:performance-budget": "node scripts/check-performance-budget.mjs",
    "check": "node scripts/run-quality-gate.mjs",
    "check:ci": "node scripts/run-quality-gate.mjs --with-e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "chess.js": "^1.4.0",
    "react": "^19.2.7",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.2.7",
    "stockfish": "^18.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
