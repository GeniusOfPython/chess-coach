# Скопируйте этот файл в .env.local. Файл .env.local уже исключён из Git.
# Ключ используется Vite только на сервере. Никогда не добавляйте ему VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=

# Главный серверный выключатель расходов. По умолчанию ИИ не тратит кредиты.
AI_COACH_SERVER_ENABLED=false

# Жёсткий дневной бюджет OpenAI в долларах на один серверный процесс.
AI_COACH_DAILY_BUDGET_USD=1

# Укажите цены выбранной модели за 1 млн токенов из актуального прайсинга.
# Значения ниже консервативны и не дадут занизить ожидаемый расход.
AI_COACH_INPUT_USD_PER_MILLION=1
AI_COACH_OUTPUT_USD_PER_MILLION=5

# Резерв на один параллельный запрос защищает бюджет от одновременных вызовов.
AI_COACH_RESERVED_INPUT_TOKENS=20000
AI_COACH_RESERVED_OUTPUT_TOKENS=450

# Публичный флаг доступности endpoint. Секретов не содержит.
VITE_AI_COACH_ENABLED=false
